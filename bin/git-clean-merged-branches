#!/usr/bin/env bash

# exit when any command fails
set -euo pipefail

# fetch origin and prune
git fetch -p

# autodetect main branch (usually master or main)
mainBranch=$(git-main-branch)

# git branch -d/-D fails if a worktree references the branch. Try to remove
# the worktree first; if it has uncommitted changes, leave it (and the branch).
remove_worktree_for_branch() {
  local branch="$1"
  local path
  path=$(git worktree list --porcelain | awk -v ref="refs/heads/$branch" '
    /^worktree / { p=$2 }
    $0 == "branch " ref { print p; exit }
  ')
  if [ -n "$path" ]; then
    if ! git worktree remove "$path" 2>/dev/null; then
      echo "Worktree at $path has uncommitted changes; leaving branch $branch in place." >&2
      return 1
    fi
  fi
  return 0
}


delete_branch() {
  local branch="$1"
  local flag="$2"
  # Don't delete a branch that points at exactly the same commit as main with no
  # other commits (e.g. a freshly created worktree/branch).
  if [ "$(git rev-parse "$branch")" = "$(git rev-parse "$mainBranch")" ]; then
    return 0
  fi
  remove_worktree_for_branch "$branch" || return 0
  git branch "$flag" "$branch" 2>/dev/null || true
}

# Delete merged branches with merge commit
git branch --merged "$mainBranch" | cut -b 3- | (grep --invert-match -F "$mainBranch" || echo) | while read -r branch; do
  [ -z "$branch" ] && continue
  delete_branch "$branch" -d
done

# https://github.com/ggilder/dotfiles/blob/master/bin/git-delete-merged-branches
# Two strategies for deleting merged branches:

# Delete branches whose diff from merge-base matches a commit on master
# i.e. branches merged in a single squashed commit
# based on https://github.com/not-an-aardvark/git-delete-squashed
git for-each-ref refs/heads/ "--format=%(refname:short)" | while read -r branch; do
[[ "$branch" == "$mainBranch" ]] && continue
  mergeBase=$(git merge-base "$mainBranch" "$branch") \
  && [[ $(git cherry "$mainBranch" "$(git commit-tree "$(git rev-parse "$branch^{tree}")" -p "$mergeBase" -m _)") == "-"* ]] \
  && delete_branch "$branch" -D \
  || true
done

# Delete squashed merges by figuring out branches that would apply no diff to
# master if merged. This attempts to address branches merged in multiple
# squashed commits.
git for-each-ref refs/heads/ "--format=%(refname:short)" | while read -r branch; do
[[ "$branch" == "$mainBranch" ]] && continue
([ -z "$(git merge-tree "$(git merge-base "$mainBranch" "$branch")" "$mainBranch" "$branch")" ] && delete_branch "$branch" -D) || true
done

# Warn of branches whose upstream has been deleted
git branch --format '%(refname:short) %(upstream:track)' | awk '$2 == "[gone]" { print $1 }' | while read -r branch; do
  echo "Found gone branch: $branch"
done
