#!/usr/bin/env bash

set -euo pipefail

# Local read, no network. Empty if origin/HEAD is not set in this clone.
readCachedHead() {
  local ref
  ref=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || return 0
  printf '%s' "${ref#origin/}"
}

mainBranch=$(readCachedHead)

if [[ -z "$mainBranch" ]]; then
  # Not set (--single-branch, older clone): query the remote once and cache it.
  git remote set-head origin --auto >/dev/null 2>&1 || true
  mainBranch=$(readCachedHead)
fi

if [[ -z "$mainBranch" ]]; then
  echo "git-main-branch: cannot determine origin default branch" >&2
  exit 1
fi

printf '%s\n' "$mainBranch"
