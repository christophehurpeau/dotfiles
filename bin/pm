#!/usr/bin/env bash
# pm: unified package-manager wrapper for npm / yarn / pnpm / bun.
#
# Detects the active package manager (nearest package.json "packageManager"
# field, else nearest lockfile via find-up) and maps short aliases to the
# matching command. Unknown subcommands pass through to the detected PM.
#
# Aliases: i/install, a/add, rm/remove, r/run, x/exec, b/build, t/test,
#          d/dev, s/start, u/update, ui/update-interactive.
#
# Update scope: every PM defaults to the package.json in $PWD only, except
# yarn berry whose `up` is always project-wide. Pass -r to `pm u` / `pm ui`
# to update every workspace package instead.
#
# Dependency: jq (for reading the packageManager field).

set -euo pipefail

# Print npm|yarn|pnpm|bun, walking up from $PWD. Exit 1 if nothing found.
_pm_detect() {
  local dir="$PWD" pm
  while :; do
    if [ -f "$dir/package.json" ]; then
      pm=$(jq -r '.packageManager // empty' "$dir/package.json" 2>/dev/null || true)
      if [ -n "$pm" ]; then
        printf '%s\n' "${pm%%@*}"
        return 0
      fi
    fi
    if [ -f "$dir/pnpm-lock.yaml" ]; then printf 'pnpm\n'; return 0; fi
    if [ -f "$dir/pnpm-workspace.yaml" ]; then printf 'pnpm\n'; return 0; fi
    if [ -f "$dir/yarn.lock" ]; then printf 'yarn\n'; return 0; fi
    if [ -f "$dir/yarn.yml" ]; then printf 'yarn\n'; return 0; fi
    if [ -f "$dir/bun.lock" ]; then printf 'bun\n'; return 0; fi
    if [ -f "$dir/bun.lockb" ]; then
      echo "Invalid bun.lockb found, run 'bun install --save-text-lockfile' to fix"
      return 1
    fi
    if [ -f "$dir/package-lock.json" ]; then printf 'npm\n'; return 0; fi
    [ "$dir" = "/" ] && return 1
    dir=$(dirname "$dir")
  done
}

# Major version of the active yarn (1 = classic, 2+ = berry).
_pm_yarn_major() {
  local v
  v=$(yarn --version 2>/dev/null || echo 1)
  printf '%s\n' "${v%%.*}"
}

# Pull the workspace-wide flag out of the arguments: sets _pm_recursive to
# 0|1 and leaves the remaining arguments in the _pm_args array.
_pm_take_recursive() {
  _pm_recursive=0
  _pm_args=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      -r|--recursive|-w|--workspaces) _pm_recursive=1 ;;
      *) _pm_args+=("$arg") ;;
    esac
  done
}

_pm_usage() {
  cat <<'EOF'
pm - unified package manager wrapper (npm / yarn / pnpm / bun)

Usage: pm [command] [args...]

Commands:
  i, install         install dependencies
  a, add <pkg>       add a dependency
  rm, remove <pkg>   remove a dependency
  r, run <script>    run a package.json script
  x, exec <bin>      execute a local binary
  b, build           run the build script
  t, test            run the test script
  d, dev             run the dev script
  s, start           run the start script
  u, update          update dependencies
  ui                 update dependencies interactively (errors if unsupported)
  -h, --help         show this help and the detected PM help

Options (u / ui):
  -r, --recursive    update every workspace package, not just the one in $PWD
                     (alias: -w, --workspaces)

Update scope without -r is the package.json in $PWD, except yarn berry:
`yarn up` / `yarn upgrade-interactive` always span the whole project.
yarn 1 has no recursive update at all and errors on -r.

Any other command is passed through to the detected package manager.
EOF
}

main() {
  local sub=""
  if [ $# -gt 0 ]; then
    sub="$1"
  fi

  # Help is handled before detection so `pm --help` works outside a project.
  case "$sub" in
    -h|--help|help)
      _pm_usage
      local pm
      if pm=$(_pm_detect 2>/dev/null); then
        printf '\nDetected package manager: %s\n' "$pm"
        printf -- '----- %s --help -----\n' "$pm"
        "$pm" --help || true
      fi
      return 0 ;;
  esac

  local pm
  if ! pm=$(_pm_detect); then
    echo "pm: no package manager detected (no packageManager field or lockfile found)" >&2
    return 1
  fi

  [ $# -gt 0 ] && shift

  case "$sub" in
    ""|i|install)
      case "$pm" in
        npm)  exec npm install "$@" ;;
        yarn) exec yarn install "$@" ;;
        pnpm) exec pnpm install "$@" ;;
        bun)  exec bun install "$@" ;;
      esac ;;
    a|add)
      case "$pm" in
        npm)  exec npm install "$@" ;;
        yarn) exec yarn add "$@" ;;
        pnpm) exec pnpm add "$@" ;;
        bun)  exec bun add "$@" ;;
      esac ;;
    rm|remove)
      case "$pm" in
        npm)  exec npm uninstall "$@" ;;
        yarn) exec yarn remove "$@" ;;
        pnpm) exec pnpm remove "$@" ;;
        bun)  exec bun remove "$@" ;;
      esac ;;
    r|run)
      case "$pm" in
        npm)  exec npm run "$@" ;;
        yarn) exec yarn run "$@" ;;
        pnpm) exec pnpm run "$@" ;;
        bun)  exec bun run "$@" ;;
      esac ;;
    x|exec)
      case "$pm" in
        npm)  exec npx "$@" ;;
        yarn)
          if [ "$(_pm_yarn_major)" = "1" ]; then exec yarn run "$@"; else exec yarn exec "$@"; fi ;;
        pnpm) exec pnpm exec "$@" ;;
        bun)  exec bunx "$@" ;;
      esac ;;
    b|build|t|test|d|dev|s|start)
      local script
      case "$sub" in
        b|build) script=build ;;
        t|test)  script=test ;;
        d|dev)   script=dev ;;
        s|start) script=start ;;
      esac
      case "$pm" in
        npm)  exec npm run "$script" "$@" ;;
        yarn) exec yarn run "$script" "$@" ;;
        pnpm) exec pnpm run "$script" "$@" ;;
        bun)  exec bun run "$script" "$@" ;;
      esac ;;
    u|update|upgrade)
      _pm_take_recursive "$@"
      set -- ${_pm_args[@]+"${_pm_args[@]}"}
      case "$pm" in
        npm)
          if [ "$_pm_recursive" = 1 ]; then
            exec npm update --workspaces --include-workspace-root "$@"
          fi
          exec npm update "$@" ;;
        yarn)
          if [ "$(_pm_yarn_major)" = "1" ]; then
            if [ "$_pm_recursive" = 1 ]; then
              echo "pm: yarn 1 cannot update every workspace at once (upgrade to yarn berry)" >&2
              return 1
            fi
            exec yarn upgrade "$@"
          fi
          # Berry's `up` is always project-wide and needs an explicit pattern.
          if [ $# -eq 0 ]; then exec yarn up '*'; fi
          exec yarn up "$@" ;;
        pnpm)
          if [ "$_pm_recursive" = 1 ]; then exec pnpm update -r "$@"; fi
          exec pnpm update "$@" ;;
        bun)
          if [ "$_pm_recursive" = 1 ]; then exec bun update --filter '*' "$@"; fi
          exec bun update "$@" ;;
      esac ;;
    ui|update-interactive|upgrade-interactive)
      _pm_take_recursive "$@"
      set -- ${_pm_args[@]+"${_pm_args[@]}"}
      case "$pm" in
        npm)
          echo "pm: npm has no interactive upgrade (use 'pm u', or 'pm x npm-check-updates')" >&2
          return 1 ;;
        yarn)
          if [ "$(_pm_yarn_major)" = "1" ] && [ "$_pm_recursive" = 1 ]; then
            echo "pm: yarn 1 cannot update every workspace at once (upgrade to yarn berry)" >&2
            return 1
          fi
          # Berry's upgrade-interactive already spans every workspace.
          exec yarn upgrade-interactive "$@" ;;
        pnpm)
          if [ "$_pm_recursive" = 1 ]; then
            exec pnpm update --latest --interactive -r "$@"
          fi
          exec pnpm update --latest --interactive "$@" ;;
        bun)
          echo "pm: bun has no interactive upgrade (use 'pm u')" >&2
          return 1 ;;
      esac ;;
    s|start)
      if [ ! -f package.json ]; then
        echo "No package.json found"
        return 1
      fi

      local startCommand='start'
      if [ "$(jq '.scripts.dev' package.json)" != "null" ]; then
        startCommand='dev'
      fi

      case "$pm" in
        npm)  exec npm run "$@" ;;
        yarn) exec yarn run "$@" ;;
        pnpm) exec pnpm run "$@" ;;
        bun)  exec bun run "$@" ;;
      esac ;;
    *)
      exec "$pm" "$sub" "$@" ;;
  esac
}

main "$@"
