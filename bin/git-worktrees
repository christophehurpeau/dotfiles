#!/usr/bin/env bash

set -euo pipefail

# List git worktrees, or interactively pick one and print its path.
# A bin cannot cd the parent shell, so the actual `cd` is done by the `wt()`
# shell function (see bash_aliases); this script only lists/resolves paths.
#
#   git-worktrees            pick a worktree, print its path
#   git-worktrees <filter>   only consider worktrees whose name, branch or path
#                            matches (case-insensitive); an exact name or branch
#                            match wins over substring matches
#   git-worktrees --list     print `name<TAB>branch<TAB>ahead<TAB>date<TAB>subject`
#                            for every worktree, where the last three describe
#                            the commits the worktree has above the main branch
#                            (the subject is truncated, see subjectWidth)
#
# A worktree's name is the last segment of its path; it identifies a worktree
# without the noise of the directory it was created in.
#
# The normal way to reach a worktree is `wt <TAB>` (zsh completion, see
# completions/_wt), which resolves to an exact name and needs no selection.
# With no argument (or an ambiguous filter) a picker is drawn on /dev/tty:
# type to filter, up/down to move, Enter to select, Esc to cancel.
#
# Cancelling the selection prints nothing and exits 0.

NOCOLOR='\033[0m'
RED='\033[0;31m'

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo -e "${RED}Not inside a git repository.${NOCOLOR}" >&2
  exit 1
fi

currentRoot=$(git rev-parse --show-toplevel 2>/dev/null || echo '')

# Bare worktrees have neither `branch` nor `detached`, so they are skipped.
names=()
branches=()
paths=()
heads=()
wtpath=''
wthead=''
addWorktree() {
  names+=("${wtpath##*/}")
  branches+=("$1")
  paths+=("$wtpath")
  heads+=("$wthead")
}
while IFS= read -r line; do
  case "$line" in
    'worktree '*) wtpath="${line#worktree }" ;;
    'HEAD '*) wthead="${line#HEAD }" ;;
    'branch '*) addWorktree "${line#branch refs/heads/}" ;;
    detached) addWorktree '(detached HEAD)' ;;
  esac
done < <(git worktree list --porcelain)

if [ "${#paths[@]}" -eq 0 ]; then
  echo -e "${RED}No worktree found.${NOCOLOR}" >&2
  exit 1
fi

# What a worktree is worth knowing about is its own work: how many commits it
# has above the main branch, and when/what the last of them was. Compared
# against `origin/<main>` when known -- a local main can lag behind the branch
# point and count upstream commits as the branch's own. Nothing here touches
# the network (`git-main-branch` may fetch, so origin/HEAD is read directly).
mainRef=''
for candidate in "$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)" \
  origin/main origin/master main master; do
  [ -n "$candidate" ] || continue
  if git rev-parse --verify --quiet "$candidate^{commit}" >/dev/null 2>&1; then
    mainRef="$candidate"
    break
  fi
done

# Filled by computeAhead, indexed like paths. `ahead` is a count, or `?` when
# no main branch exists to compare against (a repo with a single branch).
aheads=()
aheadDates=()
aheadSubjects=()
#
# A subject reaching the right margin turns any listing of these into a wall of
# text, so git truncates it (`..`) at a width that leaves the other columns
# readable. Letting git do it keeps the cut on a character boundary, which the
# byte-wise substring of bash 3.2 (macOS /bin/bash) would not.
subjectWidth=52
computeAhead() {
  aheads=()
  aheadDates=()
  aheadSubjects=()
  local i ahead adate asubject d s
  local -a range
  for i in "${!paths[@]}"; do
    ahead=0
    adate=''
    asubject=''
    if [ -n "$mainRef" ]; then
      range=("$mainRef..${heads[i]}")
    else
      # No main to subtract: describe the tip commit and own up to the count
      # being unknown rather than showing the whole history as "above main".
      ahead='?'
      range=(--max-count=1 "${heads[i]}")
    fi
    while IFS=$'\t' read -r d s; do
      # `%<(n,trunc)` also right-pads a short subject, so drop that padding
      [ -n "$adate" ] || { adate="$d" ; asubject="${s%"${s##*[![:space:]]}"}" ; }
      [ "$ahead" = '?' ] || ahead=$((ahead + 1))
    done < <(git log --format="%ad%x09%<($subjectWidth,trunc)%s" \
      --date=format:'%m-%d %H:%M' "${range[@]}" 2>/dev/null || true)
    aheads+=("$ahead")
    aheadDates+=("$adate")
    aheadSubjects+=("$asubject")
  done
}

if [ "${1:-}" = '--list' ]; then
  computeAhead
  for i in "${!paths[@]}"; do
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "${names[i]}" "${branches[i]}" "${aheads[i]}" "${aheadDates[i]}" "${aheadSubjects[i]}"
  done
  exit 0
fi

filter="${1:-}"
if [ -n "$filter" ]; then
  # An exact name (what completion inserts) or branch is never ambiguous, even
  # when it is also a prefix of other worktrees.
  for i in "${!paths[@]}"; do
    if [ "${names[i]}" = "$filter" ] || [ "${branches[i]}" = "$filter" ]; then
      printf '%s\n' "${paths[i]}"
      exit 0
    fi
  done

  filteredNames=()
  filteredBranches=()
  filteredPaths=()
  filteredHeads=()
  shopt -s nocasematch
  for i in "${!paths[@]}"; do
    case "${branches[i]} ${paths[i]}" in
      *"$filter"*)
        filteredNames+=("${names[i]}")
        filteredBranches+=("${branches[i]}")
        filteredPaths+=("${paths[i]}")
        filteredHeads+=("${heads[i]}")
        ;;
    esac
  done
  shopt -u nocasematch
  if [ "${#filteredPaths[@]}" -eq 0 ]; then
    echo -e "${RED}No worktree matching '$filter'.${NOCOLOR}" >&2
    exit 1
  fi
  names=("${filteredNames[@]}")
  branches=("${filteredBranches[@]}")
  paths=("${filteredPaths[@]}")
  heads=("${filteredHeads[@]}")
fi

if [ "${#paths[@]}" -eq 1 ]; then
  printf '%s\n' "${paths[0]}"
  exit 0
fi

computeAhead

# Display rows: name, branch, then the commits it has above main -- their
# count, and the date and subject of the last of them -- with a `*` marker on
# the worktree we are currently in. The path is not shown (the name is the part
# that distinguishes worktrees); it stays searchable, and the fzf preview
# spells it out.
nameWidth=0
branchWidth=0
aheadWidth=0
aheadLabels=()
for i in "${!branches[@]}"; do
  [ "${#names[i]}" -gt "$nameWidth" ] && nameWidth="${#names[i]}"
  [ "${#branches[i]}" -gt "$branchWidth" ] && branchWidth="${#branches[i]}"
  case "${aheads[i]}" in
    0) aheadLabels+=('0') ;;
    '?') aheadLabels+=('?') ;;
    *) aheadLabels+=("+${aheads[i]}") ;;
  esac
  [ "${#aheadLabels[i]}" -gt "$aheadWidth" ] && aheadWidth="${#aheadLabels[i]}"
done

# A wrapped row would break the cursor-up redraw of the fallback picker below,
# so the columns are fitted to the terminal rather than let overflow. Cutting
# the row instead would eat the count and date -- the point of the listing --
# to keep a name wide enough to push them off the line.
cols=$(tput cols 2>/dev/null || echo 80)
[ "$cols" -ge 40 ] 2>/dev/null || cols=80

# `2 ` marker, the 11-column date, and a 2-space gap between all five columns.
avail=$((cols - 2 - 8 - 11 - aheadWidth))
[ "$avail" -lt 14 ] && avail=14

# The name identifies the worktree, so it is served first; the branch is
# redundant with it and gives up its column entirely before the subject
# has to.
nameCol="$nameWidth"
[ "$nameCol" -gt $((avail / 2)) ] && nameCol=$((avail / 2))
[ "$nameCol" -lt 10 ] && nameCol=10
rest=$((avail - nameCol))
branchCol="$branchWidth"
[ "$branchCol" -gt $((rest / 2)) ] && branchCol=$((rest / 2))
[ "$branchCol" -lt 8 ] && branchCol=0
subjectCol=$((rest - branchCol))
[ "$subjectCol" -lt 12 ] && subjectCol=0

# Cut a field to n columns, marked like git's own `%<(n,trunc)`.
fit() {
  if [ "${#1}" -gt "$2" ]; then
    printf '%s..' "${1:0:$(($2 - 2))}"
  else
    printf '%s' "$1"
  fi
}

rows=()
for i in "${!paths[@]}"; do
  marker=' '
  [ "${paths[i]}" = "$currentRoot" ] && marker='*'
  row=$(printf '%s %-*s' "$marker" "$nameCol" "$(fit "${names[i]}" "$nameCol")")
  if [ "$branchCol" -gt 0 ]; then
    row=$(printf '%s  %-*s' "$row" "$branchCol" "$(fit "${branches[i]}" "$branchCol")")
  fi
  row=$(printf '%s  %*s  %-11s' "$row" "$aheadWidth" "${aheadLabels[i]}" "${aheadDates[i]}")
  if [ "$subjectCol" -gt 0 ]; then
    row=$(printf '%s  %s' "$row" "$(fit "${aheadSubjects[i]}" "$subjectCol")")
  fi
  # a worktree with nothing above main has no date/subject: drop their padding
  row="${row%"${row##*[![:space:]]}"}"
  rows+=("${row:0:cols}")
done

if command -v fzf >/dev/null 2>&1; then
  # fzf draws on /dev/tty, so stdout stays clean for the caller. The path is
  # carried in a trailing tab-separated field hidden from the display.
  entries=()
  for i in "${!paths[@]}"; do
    entries+=("${rows[i]}"$'\t'"${paths[i]}")
  done
  selected=$(printf '%s\n' "${entries[@]}" \
    | fzf --prompt='worktree > ' --height=40% --reverse \
          --delimiter=$'\t' --with-nth=1 \
          --preview='printf "%s\n" {2}; git -C {2} log -1 --format="%C(yellow)%h%C(reset) %s %C(dim)(%ar)%C(reset)" 2>/dev/null; git -C {2} status --short 2>/dev/null' \
          --preview-window='down,5,border-top') || selected=''
  [ -n "$selected" ] || exit 0
  printf '%s\n' "${selected#*$'\t'}"
  exit 0
fi

tty=/dev/tty
if [ ! -r "$tty" ] || [ ! -w "$tty" ]; then
  echo -e "${RED}Several worktrees to choose from, but no terminal to prompt on.${NOCOLOR}" >&2
  exit 1
fi

# A lone Esc is only known to be lone once no sequence byte follows it. bash 3.2
# (macOS /bin/bash) rejects a fractional timeout, so it waits a whole second.
if [ "${BASH_VERSINFO[0]:-0}" -ge 4 ]; then escTimeout=0.05; else escTimeout=1; fi

visibleMax=$(tput lines 2>/dev/null || echo 24)
visibleMax=$((visibleMax - 3))
[ "$visibleMax" -gt 12 ] && visibleMax=12
[ "$visibleMax" -lt 3 ] && visibleMax=3

query=''
cursor=0
pick=''

matches=()
drawnLines=0

filterRows() {
  matches=()
  local i
  if [ -z "$query" ]; then
    for i in "${!rows[@]}"; do matches+=("$i"); done
    return
  fi
  shopt -s nocasematch
  for i in "${!rows[@]}"; do
    # the row carries a ~-shortened path, so the full path is matched too
    case "${rows[i]} ${paths[i]}" in *"$query"*) matches+=("$i") ;; esac
  done
  shopt -u nocasematch
}

clearDrawn() {
  [ "$drawnLines" -gt 0 ] && printf '\033[%dA\033[J' "$drawnLines" >"$tty"
  drawnLines=0
}

draw() {
  clearDrawn
  local total="${#matches[@]}" shown=0 start=0 idx line
  shown="$total"
  [ "$shown" -gt "$visibleMax" ] && shown="$visibleMax"
  [ "$cursor" -ge "$shown" ] && start=$((cursor - shown + 1))

  printf '\033[1mworktree\033[0m > %s\033[7m \033[0m \033[2m(%d/%d)\033[0m\n' \
    "$query" "$total" "${#rows[@]}" >"$tty"
  drawnLines=1

  local n=0
  while [ "$n" -lt "$shown" ]; do
    idx="${matches[$((start + n))]}"
    line="${rows[idx]}"
    if [ "$((start + n))" -eq "$cursor" ]; then
      printf '\033[7m%s\033[0m\n' "$line" >"$tty"
    else
      printf '%s\n' "$line" >"$tty"
    fi
    drawnLines=$((drawnLines + 1))
    n=$((n + 1))
  done
  if [ "$total" -eq 0 ]; then
    printf '\033[2m  no match\033[0m\n' >"$tty"
    drawnLines=$((drawnLines + 1))
  elif [ "$total" -gt "$shown" ]; then
    printf '\033[2m  … %d more\033[0m\n' "$((total - shown))" >"$tty"
    drawnLines=$((drawnLines + 1))
  fi
}

restoreTty() { printf '\033[?25h' >"$tty" 2>/dev/null || true; }
trap restoreTty EXIT
printf '\033[?25l' >"$tty"

selected=''
filterRows
while :; do
  draw
  key=''
  if ! IFS= read -rsn1 key <"$tty"; then break; fi
  case "$key" in
    '') # Enter
      if [ "${#matches[@]}" -gt 0 ]; then
        pick="${matches[$cursor]}"
        selected="${paths[pick]}"
      fi
      break ;;
    $'\033')
      seq=''
      # Only an arrow-key sequence follows; anything else (or nothing) is a cancel.
      IFS= read -rsn2 -t "$escTimeout" seq <"$tty" || seq=''
      case "$seq" in
        '[A'|'OA') [ "$cursor" -gt 0 ] && cursor=$((cursor - 1)) ;;
        '[B'|'OB') [ "$cursor" -lt "$((${#matches[@]} - 1))" ] && cursor=$((cursor + 1)) ;;
        *) break ;;
      esac ;;
    $'\020') [ "$cursor" -gt 0 ] && cursor=$((cursor - 1)) ;;                          # ctrl-p
    $'\016') [ "$cursor" -lt "$((${#matches[@]} - 1))" ] && cursor=$((cursor + 1)) ;;   # ctrl-n
    $'\007') break ;;                                                                  # ctrl-g
    $'\177'|$'\b') query="${query%?}" ; cursor=0 ; filterRows ;;
    $'\025') query='' ; cursor=0 ; filterRows ;;                                       # ctrl-u
    [[:print:]]) query="$query$key" ; cursor=0 ; filterRows ;;
  esac
done

clearDrawn
[ -n "$selected" ] || exit 0
printf '%s\n' "$selected"
